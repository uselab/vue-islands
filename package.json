{
    "name": "@uselab/vue-islands",
    "version": "0.1.0",
    "description": "Progressively mount Vue components (\"islands\") into server-rendered semantic HTML using data attributes.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/uselab/vue-islands.git"
    },
    "keywords": [
        "vue",
        "islands",
        "islands-architecture",
        "progressive-enhancement",
        "ssr"
    ],
    "type": "module",
    "main": "./dist/vue-islands.js",
    "module": "./dist/vue-islands.js",
    "types": "./dist/vue-islands.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vue-islands.d.ts",
            "import": "./dist/vue-islands.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "npm run build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "vue": "^3.0.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "dependencies": {
        "lodash": "^4.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.59.0",
        "@types/lodash": "^4.17.25",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^5.0.3",
        "vue": "^3.5.42",
        "zod": "^4.4.3"
    }
}
