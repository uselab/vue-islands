{
    "name": "@uselab/vue-islands",
    "version": "1.0.0",
    "description": "Progressively mount Vue components (\"islands\") into server-rendered semantic HTML using data attributes.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/uselab/vue-islands.git"
    },
    "keywords": [
        "vue",
        "vue3",
        "W3C",
        "seo",
        "progressive-enhancement",
        "progressive-hydration",
        "hydration",
        "ssr",
        "server-side-rendering",
        "html"
    ],
    "type": "module",
    "main": "./dist/vue-islands.js",
    "module": "./dist/vue-islands.js",
    "types": "./dist/vue-islands.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vue-islands.d.ts",
            "import": "./dist/vue-islands.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "quality": "npm run lint && npm run typecheck && npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "prepublishOnly": "npm run build",
        "prepare": "simple-git-hooks",
        "preversion": "npm run quality",
        "postversion": "git push --follow-tags"
    },
    "simple-git-hooks": {
        "pre-push": "npm run quality"
    },
    "peerDependencies": {
        "vue": "^3.0.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "dependencies": {
        "lodash": "^4.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.59.0",
        "@playwright/test": "^1.62.1",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.4.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^5.0.3",
        "vue": "^3.5.42",
        "zod": "^4.4.3"
    }
}
